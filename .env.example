# ==============================================================================
# Tesla Allocation Portal — Environment Configuration Template
# Copy this file to .env for local overrides if needed.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (OPTIONAL)
# Defaults to the actual development and Cloud Run deployment origins:
# - http://localhost:3000,http://127.0.0.1:3000
# - https://ais-dev-jrqpsqw2uucdlib6h2sfrz-883722265969.europe-west2.run.app
# - https://ais-pre-jrqpsqw2uucdlib6h2sfrz-883722265969.europe-west2.run.app
# If specified, custom comma-separated origins are merged with these actual origins.
# No invented URLs should be used.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key: Keep private! Used ONLY server-side to administer database and bypass RLS where validated
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Anon Public Key: Safe for public client operations
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# Administration Configuration
# Comma-separated emails of users who should automatically receive admin privileges upon verified login
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@tesla-allocation-portal.internal

# ------------------------------------------------------------------------------
# Payment Gateway Configuration (OPTIONAL — Payments Disabled)
# CRITICAL: Payment integration is strictly disabled until the final stage (Stage 6).
# The backend starts and operates normally WITHOUT Stripe credentials.
# Do NOT configure live Stripe keys during development or testing.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Transactional Email Configuration (OPTIONAL — Stage 7)
# e.g., Resend or SMTP provider
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SUPPORT_EMAIL=support@tesla-allocation-portal.internal

# ==============================================================================
# Client Environment Variables (Exposed to browser via Vite prefix VITE_)
# SECURITY NOTE: Never put private secrets (service keys, Stripe keys, Resend keys)
# under VITE_ variables.
# ==============================================================================

# Public Supabase credentials for client authentication and real-time listeners
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Base URL for Backend API (OPTIONAL)
# In this architecture, Express serves both API routes (/api/*) and Vite client
# on the same origin (port 3000 in dev and production).
# Relative requests (e.g. /api/vehicles) work out of the box when this variable
# is omitted or left empty.
VITE_API_BASE_URL=
